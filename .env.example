# ============================================================
# Indian Swing — Application Settings
# ============================================================

# Application
APP_ENV=development
APP_SECRET_KEY=change-me-in-production-use-a-long-random-string
LOG_LEVEL=INFO

# Database (SQLite default)
DATABASE_URL=sqlite+aiosqlite:///./data/swing.db
# PostgreSQL alternative:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/indian_swing

# Data
DATA_DIR=./data
CACHE_DIR=./data/cache
UNIVERSE_FILE=./config/universe.csv

# yfinance
YFINANCE_THREADS=4
YFINANCE_RATE_LIMIT_DELAY=0.5

# Scanner
SCANNER_ENABLED=true
SCANNER_CRON=0 16 * * 1-5
SCANNER_MAX_WORKERS=8

# API
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# Backtesting
BACKTEST_INITIAL_CAPITAL=1000000
BACKTEST_BROKERAGE_PCT=0.0003
BACKTEST_STT_PCT=0.001
BACKTEST_SLIPPAGE_PCT=0.0005
